<ResourceDictionary xmlns="http://schemas.microsoft.com/winfx/2006/xaml/presentation"
                    xmlns:x="http://schemas.microsoft.com/winfx/2006/xaml">

    <!-- Ink, rice paper and cinnabar. Sharp corners, thin lines, one red accent. -->
    <Color x:Key="Color.Ink">#0B0A0A</Color>
    <Color x:Key="Color.Accent">#C8102E</Color>
    <Color x:Key="Color.AccentBright">#E22B47</Color>

    <SolidColorBrush x:Key="Brush.Ink" Color="{StaticResource Color.Ink}" />
    <SolidColorBrush x:Key="Brush.TitleBar" Color="#000000" />
    <SolidColorBrush x:Key="Brush.Sidebar" Color="#E0090808" />
    <!-- Boxes, fields and lines are a cool charcoal: a warm black turns brown over the red cover art. -->
    <SolidColorBrush x:Key="Brush.Panel" Color="#E6121418" />
    <SolidColorBrush x:Key="Brush.PanelSolid" Color="#14161A" />
    <SolidColorBrush x:Key="Brush.PanelRaised" Color="#1D2026" />
    <SolidColorBrush x:Key="Brush.Hover" Color="#14ECE6DA" />
    <SolidColorBrush x:Key="Brush.Field" Color="#0C0E11" />
    <!-- Secondary buttons: dark enough to stay readable over cover art. -->
    <SolidColorBrush x:Key="Brush.ButtonFill" Color="#D90C0E11" />
    <SolidColorBrush x:Key="Brush.Line" Color="#272B32" />
    <SolidColorBrush x:Key="Brush.LineStrong" Color="#3F444D" />
    <SolidColorBrush x:Key="Brush.Overlay" Color="#D9070606" />

    <SolidColorBrush x:Key="Brush.Text" Color="#ECE6DA" />
    <SolidColorBrush x:Key="Brush.TextMuted" Color="#A59C90" />
    <SolidColorBrush x:Key="Brush.TextDim" Color="#6F675E" />
    <SolidColorBrush x:Key="Brush.OnAccent" Color="#FFF7EE" />

    <SolidColorBrush x:Key="Brush.Accent" Color="{StaticResource Color.Accent}" />
    <SolidColorBrush x:Key="Brush.AccentBright" Color="{StaticResource Color.AccentBright}" />
    <SolidColorBrush x:Key="Brush.AccentDeep" Color="#5C0E1A" />
    <SolidColorBrush x:Key="Brush.AccentWash" Color="#22C8102E" />

    <SolidColorBrush x:Key="Brush.Success" Color="#86B793" />
    <SolidColorBrush x:Key="Brush.Warning" Color="#D9A84E" />
    <SolidColorBrush x:Key="Brush.Danger" Color="#E5485F" />
    <!-- Edit: a box that changes something by hand, such as a mod's name. -->
    <SolidColorBrush x:Key="Brush.Edit" Color="#6EA4D8" />
    <!-- Cloudflare's own orange, for its name where the app says the remote data came from there. -->
    <SolidColorBrush x:Key="Brush.Cloudflare" Color="#F38020" />
    <!-- GitHub's blue on a dark page, for its name in the same place. -->
    <SolidColorBrush x:Key="Brush.GitHub" Color="#4493F8" />
    <!-- Blue for the recommended mod: its card gets a slight tint; its notes box and the word on the Mods entry the full color. -->
    <SolidColorBrush x:Key="Brush.Info" Color="#4493F8" />
    <SolidColorBrush x:Key="Brush.InfoWash" Color="#224493F8" />
    <SolidColorBrush x:Key="Brush.InfoPanel" Color="#E6141C2A" />
    <SolidColorBrush x:Key="Brush.InfoLine" Color="#444493F8" />
    <!-- A little darker than the recommended card: the row of a mod that puts files beside the game's own. -->
    <SolidColorBrush x:Key="Brush.GameFilesRow" Color="#E6111825" />

    <!-- Faint fills in the same tones, for boxes that carry a state. -->
    <SolidColorBrush x:Key="Brush.SuccessWash" Color="#1A86B793" />
    <SolidColorBrush x:Key="Brush.WarningWash" Color="#24D9A84E" />
    <SolidColorBrush x:Key="Brush.DangerWash" Color="#1FE5485F" />
    <SolidColorBrush x:Key="Brush.EditWash" Color="#246EA4D8" />
    <SolidColorBrush x:Key="Brush.TextMutedWash" Color="#0FA59C90" />

    <!-- A short cinnabar stroke under page titles, fading out like a brush lifting off paper. -->
    <LinearGradientBrush x:Key="Brush.Stroke" StartPoint="0,0" EndPoint="1,0">
        <GradientStop Color="#E0C8102E" Offset="0" />
        <GradientStop Color="#00C8102E" Offset="1" />
    </LinearGradientBrush>

    <!-- Body text, titles, labels and icons. Font.Heading can point to a font in Theme\Fonts (see Theme\README.md).
         For Traditional Chinese, LanguageFonts puts Microsoft JhengHei UI in place of Microsoft YaHei UI, so views
         take Font.Body, Font.Heading and Font.Label as DynamicResource. -->
    <FontFamily x:Key="Font.Body">Segoe UI Variable Text, Segoe UI, Microsoft YaHei UI</FontFamily>
    <FontFamily x:Key="Font.Heading">Palatino Linotype, Georgia, Microsoft YaHei UI</FontFamily>
    <FontFamily x:Key="Font.Label">Bahnschrift, Segoe UI, Microsoft YaHei UI</FontFamily>
    <FontFamily x:Key="Font.Icons">Segoe Fluent Icons, Segoe MDL2 Assets</FontFamily>

</ResourceDictionary>
