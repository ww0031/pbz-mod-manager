<UserControl x:Class="UEManager.UI.Views.ChangelogDialog"
             xmlns="http://schemas.microsoft.com/winfx/2006/xaml/presentation"
             xmlns:x="http://schemas.microsoft.com/winfx/2006/xaml"
             xmlns:d="http://schemas.microsoft.com/expression/blend/2008"
             xmlns:mc="http://schemas.openxmlformats.org/markup-compatibility/2006"
             xmlns:ui="clr-namespace:UEManager.UI"
             xmlns:vm="clr-namespace:UEManager.UI.ViewModels"
             xmlns:services="clr-namespace:UEManager.UI.Services"
             mc:Ignorable="d"
             d:DataContext="{d:DesignInstance Type=vm:AppUpdateViewModel}">
    <Border Style="{StaticResource Dialog}" Width="600">
        <StackPanel>
            <TextBlock Style="{StaticResource Text.Overline}" Text="{ui:Loc 'Changelog', Tracked=True}" />
            <TextBlock Margin="0,8,0,0" Style="{StaticResource Text.Title}" Text="{ui:Loc 'What changed in each version'}" />

            <!-- Every release, newest first: its version and date, then one short line per change. -->
            <Border Margin="0,14,0,0" MaxHeight="300" Padding="16,6,16,10" CornerRadius="2" BorderThickness="1"
                    Background="{StaticResource Brush.Field}" BorderBrush="{StaticResource Brush.Line}">
                <ScrollViewer VerticalScrollBarVisibility="Auto" HorizontalScrollBarVisibility="Disabled">
                    <ItemsControl ItemsSource="{Binding Releases}" Focusable="False">
                        <ItemsControl.ItemTemplate>
                            <DataTemplate DataType="{x:Type services:ChangelogRelease}">
                                <StackPanel Margin="0,10,0,0">
                                    <StackPanel Orientation="Horizontal">
                                        <TextBlock FontWeight="SemiBold" Foreground="{StaticResource Brush.Text}" Text="{Binding Version}" />
                                        <TextBlock Margin="10,0,0,0" VerticalAlignment="Bottom" Style="{StaticResource Text.Small}"
                                                   Foreground="{StaticResource Brush.TextDim}" Text="{Binding DateText}" />
                                    </StackPanel>
                                    <ItemsControl Margin="0,4,0,0" ItemsSource="{Binding Changes}" Focusable="False">
                                        <ItemsControl.ItemTemplate>
                                            <DataTemplate>
                                                <DockPanel Margin="0,2,0,0">
                                                    <TextBlock DockPanel.Dock="Left" Margin="0,0,8,0" FontSize="12.5" Foreground="{StaticResource Brush.TextDim}" Text="-" />
                                                    <TextBlock FontSize="12.5" TextWrapping="Wrap" Foreground="{StaticResource Brush.TextMuted}" Text="{Binding}" />
                                                </DockPanel>
                                            </DataTemplate>
                                        </ItemsControl.ItemTemplate>
                                    </ItemsControl>
                                </StackPanel>
                            </DataTemplate>
                        </ItemsControl.ItemTemplate>
                    </ItemsControl>
                </ScrollViewer>
            </Border>

            <!-- A donation, fully optional: the afdian page where the player picks the amount. -->
            <Border Margin="0,14,0,0" Padding="16,14" CornerRadius="2" BorderThickness="1"
                    Background="{StaticResource Brush.Field}" BorderBrush="{StaticResource Brush.Line}">
                <DockPanel>
                    <Button DockPanel.Dock="Right" Margin="16,0,0,0" VerticalAlignment="Center" Style="{StaticResource Button.Primary}"
                            Content="{ui:Loc 'Donate any amount'}" ui:Icon.Glyph="&#xEB52;" Command="{Binding DonateAnyAmountCommand}"
                            ToolTip="{ui:Loc 'Opens afdian in your browser, where you choose the amount'}" />
                    <StackPanel>
                        <TextBlock FontWeight="SemiBold" TextWrapping="Wrap" Foreground="{StaticResource Brush.Text}"
                                   Text="{ui:Loc 'Enjoying the manager? Buy the author a milk tea'}" />
                        <TextBlock Margin="0,4,0,0" FontSize="12.5" TextWrapping="Wrap" Foreground="{StaticResource Brush.TextMuted}"
                                   Text="{ui:Loc 'The manager is free and open source, and every feature works without a donation. If it saved you time setting up mods, you can support the author on afdian with any amount you like. Every bit is a big encouragement and keeps the updates coming.'}" />
                    </StackPanel>
                </DockPanel>
            </Border>

            <DockPanel Margin="0,20,0,0" LastChildFill="False">
                <Button DockPanel.Dock="Right" Margin="16,0,0,0" Content="{ui:Loc 'Close'}"
                        Command="{Binding CloseChangelogCommand}" IsCancel="True" />
                <CheckBox DockPanel.Dock="Right" VerticalAlignment="Center" Content="{ui:Loc 'Do not show again'}" IsChecked="{Binding HideChangelog}"
                          ToolTip="{ui:Loc 'The changelog no longer opens by itself after an update. Changelog at the bottom left still shows it any time.'}" />
                <Button DockPanel.Dock="Left" Content="{ui:Loc 'All releases on GitHub'}" ui:Icon.Glyph="&#xE8A7;"
                        Command="{Binding OpenAllReleasesCommand}" ToolTip="{ui:Loc 'Every release with its full notes'}" />
            </DockPanel>
        </StackPanel>
    </Border>
</UserControl>
