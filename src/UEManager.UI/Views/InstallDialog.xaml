<UserControl x:Class="UEManager.UI.Views.InstallDialog"
             xmlns="http://schemas.microsoft.com/winfx/2006/xaml/presentation"
             xmlns:x="http://schemas.microsoft.com/winfx/2006/xaml"
             xmlns:d="http://schemas.microsoft.com/expression/blend/2008"
             xmlns:mc="http://schemas.openxmlformats.org/markup-compatibility/2006"
             xmlns:ui="clr-namespace:UEManager.UI"
             xmlns:vm="clr-namespace:UEManager.UI.ViewModels"
             xmlns:views="clr-namespace:UEManager.UI.Views"
             mc:Ignorable="d"
             d:DataContext="{d:DesignInstance Type=vm:InstallDialogViewModel}">
    <Border Style="{StaticResource Dialog}" Width="660">
        <DockPanel>

            <!-- Header -->
            <StackPanel DockPanel.Dock="Top">
                <TextBlock Style="{StaticResource Text.Overline}" Text="{ui:Loc 'Install mod', Tracked=True}" />
                <TextBlock Margin="0,8,0,0" Style="{StaticResource Text.Title}" TextWrapping="NoWrap"
                           TextTrimming="CharacterEllipsis" Text="{Binding SourceFileName}" ToolTip="{Binding SourceFileName}" />
                <TextBlock Margin="0,4,0,0" Style="{StaticResource Text.Small}" Text="{Binding Summary}" />
            </StackPanel>

            <!-- Buttons -->
            <DockPanel DockPanel.Dock="Bottom" Margin="0,22,0,0" LastChildFill="False">
                <Button DockPanel.Dock="Right" Margin="8,0,0,0" Style="{StaticResource Button.Primary}"
                        Content="{Binding ConfirmText}" ui:Icon.Glyph="&#xE896;" Command="{Binding InstallCommand}" IsDefault="True" />
                <Button DockPanel.Dock="Right" Content="{ui:Loc 'Cancel'}" Command="{Binding CancelCommand}" IsCancel="True" />
            </DockPanel>

            <!-- The script loader the mod runs in is missing: install it from here, under the problem that says so. -->
            <Button DockPanel.Dock="Bottom" Margin="22,8,0,0" HorizontalAlignment="Left" Content="{Binding InstallLoaderText}" ui:Icon.Glyph="&#xE896;"
                    Command="{Binding InstallLoaderCommand}"
                    Visibility="{Binding InstallLoaderText, Converter={StaticResource VisibleIfSet}}" />

            <!-- Problems stop the install: always in view, next to the button they turn off. -->
            <ItemsControl DockPanel.Dock="Bottom" ItemsSource="{Binding Problems}" Focusable="False">
                <ItemsControl.ItemTemplate>
                    <DataTemplate>
                        <DockPanel Margin="0,10,0,0">
                            <TextBlock DockPanel.Dock="Left" Margin="0,2,10,0" VerticalAlignment="Top" Style="{StaticResource Text.Icon}"
                                       FontSize="12" Foreground="{StaticResource Brush.Danger}" Text="&#xEA39;" />
                            <TextBlock TextWrapping="Wrap" LineHeight="19" Foreground="{StaticResource Brush.Danger}" Text="{Binding}" />
                        </DockPanel>
                    </DataTemplate>
                </ItemsControl.ItemTemplate>
            </ItemsControl>
            <ScrollViewer Margin="0,20,0,0" VerticalScrollBarVisibility="Auto" HorizontalScrollBarVisibility="Disabled">
                <StackPanel>

                    <!-- Name and version -->
                    <Grid>
                        <Grid.ColumnDefinitions>
                            <ColumnDefinition Width="*" />
                            <ColumnDefinition Width="16" />
                            <ColumnDefinition Width="160" />
                        </Grid.ColumnDefinitions>
                        <StackPanel>
                            <TextBlock Style="{StaticResource Text.Caption}" Text="{ui:Loc 'Name', Tracked=True}" />
                            <TextBox Margin="0,6,0,0" Text="{Binding Name, UpdateSourceTrigger=PropertyChanged}" />
                        </StackPanel>
                        <StackPanel Grid.Column="2">
                            <TextBlock Style="{StaticResource Text.Caption}" Text="{ui:Loc 'Version', Tracked=True}" />
                            <TextBox Margin="0,6,0,0" Text="{Binding Version, UpdateSourceTrigger=PropertyChanged}" Tag="{ui:Loc 'Optional'}" />
                        </StackPanel>
                    </Grid>

                    <!-- The player's own words for the mod: optional. -->
                    <StackPanel Margin="0,12,0,0" Visibility="{Binding HasPackages, Converter={StaticResource Visible}}">
                        <TextBlock Style="{StaticResource Text.Caption}" Text="{ui:Loc 'Tags', Tracked=True}" />
                        <TextBox Margin="0,6,0,0" Text="{Binding Tags, UpdateSourceTrigger=PropertyChanged, NotifyOnTargetUpdated=True}" ui:CaretAtEnd.OnUpdate="True"
                                 Tag="{ui:Loc 'Separate with commas, such as Combat, UI'}">
                            <TextBox.InputBindings>
                                <KeyBinding Key="Tab" Command="{Binding AcceptSuggestionCommand}" />
                            </TextBox.InputBindings>
                        </TextBox>
                    <!-- Tags to pick: the player's own first, then common ones; they narrow as the player types, and Tab takes the first. -->
                    <DockPanel Margin="0,8,0,0" Visibility="{Binding HasSuggestions, Converter={StaticResource Visible}}">
                        <TextBlock DockPanel.Dock="Left" Margin="0,4,8,0" VerticalAlignment="Top" Style="{StaticResource Text.Small}" Text="{ui:Loc 'Suggestions:'}" />
                        <ItemsControl x:Name="TagHints" ItemsSource="{Binding Suggestions}" Focusable="False">
                            <ItemsControl.ItemsPanel>
                                <ItemsPanelTemplate>
                                    <WrapPanel />
                                </ItemsPanelTemplate>
                            </ItemsControl.ItemsPanel>
                            <ItemsControl.ItemTemplate>
                                <DataTemplate>
                                    <Button Style="{StaticResource Button.Suggestion}" CommandParameter="{Binding}"
                                            Command="{Binding DataContext.AddSuggestionCommand, ElementName=TagHints}">
                                        <TextBlock FontSize="12" Text="{Binding}" />
                                    </Button>
                                </DataTemplate>
                            </ItemsControl.ItemTemplate>
                        </ItemsControl>
                    </DockPanel>
                    </StackPanel>

                    <!-- The same file names as an installed mod: only the player knows whether this is its update. -->
                    <Border Margin="0,14,0,0" Padding="14,10" CornerRadius="2" BorderThickness="1"
                            Background="{StaticResource Brush.InfoPanel}" BorderBrush="{StaticResource Brush.Info}"
                            Visibility="{Binding HasPlaces, Converter={StaticResource Visible}}">
                        <StackPanel>
                            <TextBlock TextWrapping="Wrap" LineHeight="19" Text="{ui:Loc 'An installed mod has the same file names. Update it, or keep both:'}" />
                            <ItemsControl Margin="0,8,0,0" ItemsSource="{Binding Places}" Focusable="False">
                                <ItemsControl.ItemTemplate>
                                    <DataTemplate DataType="{x:Type vm:PlaceOptionViewModel}">
                                        <RadioButton Margin="0,0,0,4" IsChecked="{Binding IsSelected}">
                                            <TextBlock TextWrapping="Wrap" Text="{Binding Label}" />
                                        </RadioButton>
                                    </DataTemplate>
                                </ItemsControl.ItemTemplate>
                            </ItemsControl>
                            <TextBlock Margin="0,6,0,0" TextWrapping="Wrap" LineHeight="19" Foreground="{StaticResource Brush.Warning}"
                                       Text="{Binding KeepBothText}" Visibility="{Binding KeepBothText, Converter={StaticResource VisibleIfSet}}" />
                        </StackPanel>
                    </Border>

                    <!-- Packages -->
                    <TextBlock Margin="0,22,0,8" Style="{StaticResource Text.Caption}" Text="{ui:Loc 'Contents', Tracked=True}"
                               Visibility="{Binding HasPackages, Converter={StaticResource Visible}}" />
                    <ItemsControl ItemsSource="{Binding Packages}" Focusable="False">
                        <ItemsControl.ItemTemplate>
                            <DataTemplate DataType="{x:Type vm:PackageOptionViewModel}">
                                <Border Margin="0,0,0,6" Padding="14,10" CornerRadius="2"
                                        Background="{StaticResource Brush.Field}" BorderBrush="{StaticResource Brush.Line}" BorderThickness="1">
                                    <DockPanel>
                                        <StackPanel DockPanel.Dock="Right" Orientation="Horizontal" VerticalAlignment="Top">
                                            <TextBlock Margin="0,0,10,0" VerticalAlignment="Center" Style="{StaticResource Text.Small}" Text="{Binding SizeText}" />
                                            <Border Style="{StaticResource Badge}">
                                                <TextBlock FontFamily="{DynamicResource Font.Label}" FontSize="11" Text="{Binding KindText}" />
                                            </Border>
                                        </StackPanel>
                                        <StackPanel>
                                            <!-- Variants are one choice; other parts can be picked freely. -->
                                            <Grid>
                                                <CheckBox IsChecked="{Binding IsSelected}" Visibility="{Binding IsVariant, Converter={StaticResource Hidden}}">
                                                    <TextBlock FontWeight="SemiBold" TextTrimming="CharacterEllipsis" Text="{Binding Label}" />
                                                </CheckBox>
                                                <RadioButton IsChecked="{Binding IsSelected}" Visibility="{Binding IsVariant, Converter={StaticResource Visible}}">
                                                    <TextBlock FontWeight="SemiBold" TextTrimming="CharacterEllipsis" Text="{Binding Label}" />
                                                </RadioButton>
                                            </Grid>
                                            <TextBlock Margin="26,4,0,0" FontSize="11.5" Foreground="{StaticResource Brush.TextDim}"
                                                       TextTrimming="CharacterEllipsis" Text="{Binding FilesText}" />
                                            <!-- Not ticked at first: a DLL next to the game's exe runs when the game starts. -->
                                            <TextBlock Margin="26,4,0,0" FontSize="11.5" TextWrapping="Wrap" Foreground="{StaticResource Brush.Warning}"
                                                       Text="{ui:Loc 'Not ticked: this goes next to the game\'s exe, where Windows loads a DLL when the game starts. Tick it only if the mod\'s page says so.'}"
                                                       Visibility="{Binding IsUncertain, Converter={StaticResource Visible}}" />
                                        </StackPanel>
                                    </DockPanel>
                                </Border>
                            </DataTemplate>
                        </ItemsControl.ItemTemplate>
                    </ItemsControl>

                    <!-- Where the files of the ticked parts go, as the mod details show them once installed. -->
                    <TextBlock Margin="0,18,0,6" Style="{StaticResource Text.Caption}" Text="{ui:Loc 'Files in the game', Tracked=True}"
                               Visibility="{Binding HasRows, Converter={StaticResource Visible}}" />
                    <views:FileTree MaxHeight="220" DataContext="{Binding Rows}"
                                    Visibility="{Binding DataContext.HasRows, RelativeSource={RelativeSource AncestorType=UserControl}, Converter={StaticResource Visible}}" />
                    <TextBlock Margin="0,6,0,0" Style="{StaticResource Text.Small}" TextTrimming="None" TextWrapping="Wrap"
                               Text="{Binding IgnoredText}" Visibility="{Binding IgnoredText, Converter={StaticResource VisibleIfSet}}" />

                    <!-- Update notice -->
                    <Border Margin="0,10,0,0" Padding="14,10" CornerRadius="2" BorderThickness="1"
                            Background="{StaticResource Brush.AccentWash}" BorderBrush="{StaticResource Brush.AccentDeep}"
                            Visibility="{Binding ReplaceText, Converter={StaticResource VisibleIfSet}}">
                        <DockPanel>
                            <TextBlock DockPanel.Dock="Left" Margin="0,1,10,0" VerticalAlignment="Top" Style="{StaticResource Text.Icon}"
                                       Foreground="{StaticResource Brush.Text}" Text="&#xE895;" />
                            <TextBlock TextWrapping="Wrap" LineHeight="19" Text="{Binding ReplaceText}" />
                        </DockPanel>
                    </Border>

                    <!-- Settings the player changed: kept unless the box is cleared. -->
                    <Border Margin="0,6,0,0" Padding="14,10" CornerRadius="2" BorderThickness="1"
                            Background="{StaticResource Brush.Field}" BorderBrush="{StaticResource Brush.LineStrong}"
                            Visibility="{Binding EditedSettingsText, Converter={StaticResource VisibleIfSet}}">
                        <StackPanel>
                            <CheckBox IsChecked="{Binding KeepSettings}">
                                <TextBlock FontWeight="SemiBold" Text="{ui:Loc 'Keep my settings'}" />
                            </CheckBox>
                            <TextBlock Margin="26,4,0,0" TextWrapping="Wrap" LineHeight="18" Style="{StaticResource Text.Small}"
                                       TextTrimming="None" Text="{Binding EditedSettingsText}" />
                        </StackPanel>
                    </Border>

                    <!-- Warnings do not stop the install. -->
                    <ItemsControl ItemsSource="{Binding Warnings}" Focusable="False">
                        <ItemsControl.ItemTemplate>
                            <DataTemplate>
                                <DockPanel Margin="0,4">
                                    <TextBlock DockPanel.Dock="Left" Margin="0,2,10,0" VerticalAlignment="Top" Style="{StaticResource Text.Icon}"
                                               FontSize="12" Foreground="{StaticResource Brush.Warning}" Text="&#xE7BA;" />
                                    <TextBlock TextWrapping="Wrap" LineHeight="19" Foreground="{StaticResource Brush.Warning}" Text="{Binding}" />
                                </DockPanel>
                            </DataTemplate>
                        </ItemsControl.ItemTemplate>
                    </ItemsControl>
                    <Button Margin="22,8,0,0" HorizontalAlignment="Left" Content="{ui:Loc 'Install UE4SS…'}" ui:Icon.Glyph="&#xE946;"
                            Command="{Binding ShowUe4ssGuideCommand}"
                            Visibility="{Binding NeedsUe4ss, Converter={StaticResource Visible}}" />
                </StackPanel>
            </ScrollViewer>
        </DockPanel>
    </Border>
</UserControl>
