<UserControl x:Class="UEManager.UI.Views.ModsView"
             xmlns="http://schemas.microsoft.com/winfx/2006/xaml/presentation"
             xmlns:x="http://schemas.microsoft.com/winfx/2006/xaml"
             xmlns:d="http://schemas.microsoft.com/expression/blend/2008"
             xmlns:mc="http://schemas.openxmlformats.org/markup-compatibility/2006"
             xmlns:ui="clr-namespace:UEManager.UI"
             xmlns:vm="clr-namespace:UEManager.UI.ViewModels"
             mc:Ignorable="d"
             d:DataContext="{d:DesignInstance Type=vm:MainViewModel}">
    <UserControl.Resources>
        <ResourceDictionary>
            <ResourceDictionary.MergedDictionaries>
                <ResourceDictionary Source="ModsResources.xaml" />
            </ResourceDictionary.MergedDictionaries>
        </ResourceDictionary>
    </UserControl.Resources>

    <StackPanel>

        <!-- Header -->
        <Grid Margin="0,6,0,0">
            <StackPanel>
                <TextBlock Style="{StaticResource Text.Overline}" Text="{ui:Loc 'Collection', Tracked=True}" />
                <TextBlock Margin="0,10,0,0" Style="{StaticResource Text.Display}" Text="{ui:Loc 'Mods'}" />
                <Rectangle Width="200" Height="2" Margin="0,14,0,0" HorizontalAlignment="Left" Fill="{StaticResource Brush.Stroke}" />
            </StackPanel>
            <StackPanel HorizontalAlignment="Right" VerticalAlignment="Top" Orientation="Horizontal">
                <Button Style="{StaticResource Button.Primary}" Content="{ui:Loc 'Install from 7z/zip/rar…'}"
                        ui:Icon.Glyph="&#xE896;" Command="{Binding InstallFromArchiveCommand}" />
                <Button Margin="8,0,0,0" Content="{ui:Loc 'Install from folder…'}" ui:Icon.Glyph="&#xE8B7;" Command="{Binding InstallFromFolderCommand}" />
            </StackPanel>
        </Grid>

        <!-- A mod from its Nexus Mods link, and the update check for the mods that came from there. -->
        <DockPanel Margin="0,26,0,0">
            <Button DockPanel.Dock="Right" Margin="10,0,0,0" Style="{StaticResource Button.Primary}" Content="{Binding UpdateAllText}" ui:Icon.Glyph="&#xE896;"
                    Command="{Binding UpdateAllNexusModsCommand}" Visibility="{Binding HasNexusUpdates, Converter={StaticResource Visible}}" />
            <Button DockPanel.Dock="Right" Margin="10,0,0,0" Content="{ui:Loc 'Check for updates'}" ui:Icon.Glyph="&#xE895;"
                    Command="{Binding CheckNexusUpdatesCommand}" IsEnabled="{Binding CanCheckNexusUpdates}"
                    ToolTip="{ui:Loc 'Looks up each mod from Nexus Mods there. No account needed.'}" />
            <Button DockPanel.Dock="Right" Margin="10,0,0,0" Content="{ui:Loc 'Import'}" ui:Icon.Glyph="&#xE71B;"
                    Command="{Binding ImportNexusLinkCommand}" IsDefault="{Binding IsKeyboardFocusWithin, ElementName=NexusLinkBox}" />
            <TextBox x:Name="NexusLinkBox" Style="{StaticResource TextBox.Search}" Text="{Binding NexusLink, UpdateSourceTrigger=PropertyChanged}"
                     Tag="{ui:Loc 'Paste a Nexus Mods link, such as https://www.nexusmods.com/phantombladezero/mods/260'}" />
        </DockPanel>

        <!-- The loaders' card is on the Loaders page now; one line here says when it wants the player. -->
        <Button Margin="0,12,0,0" HorizontalAlignment="Left" Style="{StaticResource Button.StatusBox}" Command="{Binding ShowLoadersCommand}"
                Foreground="{StaticResource Brush.Info}" BorderBrush="{StaticResource Brush.Info}" Background="{StaticResource Brush.InfoWash}"
                Visibility="{Binding LoadersNeedAttention, Converter={StaticResource Visible}}">
            <StackPanel Orientation="Horizontal">
                <TextBlock Style="{StaticResource Text.Icon}" FontSize="12" Text="&#xE946;" />
                <TextBlock Margin="8,0,0,0" VerticalAlignment="Center" FontSize="12" Text="{ui:Loc 'A script loader has an update or needs a look: open Loaders'}" />
            </StackPanel>
        </Button>

        <!-- Downloads whose install was cancelled or failed: installed from here without downloading again. -->
        <Border Margin="0,12,0,0" Padding="16,10" Style="{StaticResource Card}" Visibility="{Binding HasKeptDownloads, Converter={StaticResource Visible}}">
            <StackPanel>
                <StackPanel Orientation="Horizontal">
                    <TextBlock VerticalAlignment="Center" Style="{StaticResource Text.Icon}" FontSize="13" Foreground="{StaticResource Brush.Info}" Text="&#xE896;" />
                    <TextBlock Margin="10,0,0,0" VerticalAlignment="Center" Style="{StaticResource Text.Small}" Text="{Binding KeptDownloadsText}" />
                </StackPanel>
                <ItemsControl ItemsSource="{Binding KeptDownloads}" Focusable="False">
                    <ItemsControl.ItemTemplate>
                        <DataTemplate DataType="{x:Type vm:KeptDownloadViewModel}">
                            <DockPanel Margin="23,8,0,0">
                                <Button DockPanel.Dock="Right" Margin="8,0,0,0" VerticalAlignment="Center" Padding="8,3" FontSize="12"
                                        Content="{ui:Loc 'Delete'}" ui:Icon.Glyph="&#xE74D;" Command="{Binding DeleteCommand}" />
                                <Button DockPanel.Dock="Right" VerticalAlignment="Center" Padding="8,3" FontSize="12" Style="{StaticResource Button.Primary}"
                                        Content="{ui:Loc 'Install'}" ui:Icon.Glyph="&#xE896;" Command="{Binding InstallCommand}" />
                                <TextBlock DockPanel.Dock="Right" Margin="12,0" VerticalAlignment="Center" Style="{StaticResource Text.Small}"
                                           Foreground="{StaticResource Brush.TextDim}" Text="{Binding SizeText}" />
                                <TextBlock VerticalAlignment="Center" TextTrimming="CharacterEllipsis" Text="{Binding Title}" ToolTip="{Binding Path}" />
                            </DockPanel>
                        </DataTemplate>
                    </ItemsControl.ItemTemplate>
                </ItemsControl>
            </StackPanel>
        </Border>

        <!-- Search -->
        <DockPanel Margin="0,26,0,12">
            <Button DockPanel.Dock="Right" Margin="10,0,0,0" Content="{ui:Loc 'Test without mods'}" ui:Icon.Glyph="&#xE7E8;"
                    Command="{Binding TestWithoutModsCommand}" IsEnabled="{Binding CanTestWithoutMods}" ToolTipService.ShowOnDisabled="True"
                    ToolTip="{ui:Loc 'Turns every mod off and remembers which ones were on, to see whether the game runs without them. One click turns them back on.'}" />
            <Button DockPanel.Dock="Right" Margin="10,0,0,0" Content="{ui:Loc 'Mod sets…'}" ui:Icon.Glyph="&#xE81E;"
                    Command="{Binding ShowModSetsCommand}" ToolTip="{ui:Loc 'Save the mods that are on as a set, and turn on a set with one click'}" />
            <Border DockPanel.Dock="Right" Margin="10,0,0,0" Style="{StaticResource FieldBox}">
                <TextBlock VerticalAlignment="Center" Style="{StaticResource Text.Small}" Text="{Binding ModsCountText}" />
            </Border>
            <Button DockPanel.Dock="Right" Margin="10,0,0,0" Content="{ui:Loc 'Refresh'}" ui:Icon.Glyph="&#xE72C;"
                    Command="{Binding RefreshCommand}" ToolTip="F5" />
            <TextBox x:Name="SearchBox" Style="{StaticResource TextBox.Search}" Text="{Binding SearchText, UpdateSourceTrigger=PropertyChanged}" ToolTip="Ctrl+F"
                     Tag="{ui:Loc 'Filter: mod name, version, PAK / IoStore, file name or tag'}" />
        </DockPanel>

        <!-- Which mods the list shows: by their state, and by the player's tags once a mod has one; on the right, cards or table. -->
        <DockPanel Margin="0,0,0,6" Visibility="{Binding HasFilterRow, Converter={StaticResource Visible}}">
            <ItemsControl DockPanel.Dock="Right" VerticalAlignment="Top" ItemsSource="{Binding ModsViewModes}" Focusable="False"
                          ItemTemplate="{StaticResource FilterButton}">
                <ItemsControl.ItemsPanel>
                    <ItemsPanelTemplate>
                        <StackPanel Orientation="Horizontal" />
                    </ItemsPanelTemplate>
                </ItemsControl.ItemsPanel>
            </ItemsControl>
            <ItemsControl DockPanel.Dock="Left" VerticalAlignment="Top" ItemsSource="{Binding StateFilters}" Focusable="False"
                          ItemTemplate="{StaticResource FilterButton}">
                <ItemsControl.ItemsPanel>
                    <ItemsPanelTemplate>
                        <StackPanel Orientation="Horizontal" />
                    </ItemsPanelTemplate>
                </ItemsControl.ItemsPanel>
            </ItemsControl>
            <Border DockPanel.Dock="Left" Width="1" Height="18" Margin="4,4,10,0" VerticalAlignment="Top" Background="{StaticResource Brush.LineStrong}"
                    Visibility="{Binding HasTagFilters, Converter={StaticResource Visible}}" />
            <ItemsControl ItemsSource="{Binding TagFilters}" Focusable="False" ItemTemplate="{StaticResource FilterButton}"
                          Visibility="{Binding HasTagFilters, Converter={StaticResource Visible}}">
                <ItemsControl.ItemsPanel>
                    <ItemsPanelTemplate>
                        <WrapPanel />
                    </ItemsPanelTemplate>
                </ItemsControl.ItemsPanel>
            </ItemsControl>
        </DockPanel>

        <!-- A test without mods is on -->
        <Border Margin="0,0,0,12" Style="{StaticResource Card}" Padding="22,16"
                Visibility="{Binding IsTestingWithoutMods, Converter={StaticResource Visible}}">
            <DockPanel>
                <Button DockPanel.Dock="Right" VerticalAlignment="Center" Style="{StaticResource Button.Primary}"
                        Content="{ui:Loc 'Turn them back on'}" ui:Icon.Glyph="&#xE7A7;" Command="{Binding TurnModsBackOnCommand}" />
                <TextBlock DockPanel.Dock="Left" Margin="0,0,16,0" Style="{StaticResource Text.Icon}" FontSize="18"
                           Foreground="{StaticResource Brush.Warning}" Text="&#xE7E8;" />
                <StackPanel VerticalAlignment="Center" Margin="0,0,16,0">
                    <TextBlock FontWeight="SemiBold" TextWrapping="Wrap" Text="{Binding TestText}" />
                    <TextBlock Margin="0,3,0,0" Style="{StaticResource Text.Small}" TextWrapping="Wrap"
                               Text="{ui:Loc 'Start the game and see whether the problem stays. UE4SS itself and files you put into the game by hand stay in place.'}" />
                </StackPanel>
            </DockPanel>
        </Border>

        <!-- Cards: the preview mode -->
        <StackPanel Visibility="{Binding ModsAsCards, Converter={StaticResource Visible}}">
            <ItemsControl ItemsSource="{Binding ModsView}" Focusable="False" ItemTemplate="{StaticResource ModCard}" />
            <Border Style="{StaticResource Card}" Padding="0,52" Visibility="{Binding ShowEmpty, Converter={StaticResource Visible}}">
                <StackPanel HorizontalAlignment="Center">
                    <ContentControl Style="{StaticResource BrandMark}" Width="40" Height="40" Opacity="0.5" />
                    <TextBlock Margin="0,16,0,0" HorizontalAlignment="Center" Style="{StaticResource Text.Title}" Text="{Binding EmptyTitle}" />
                    <TextBlock Margin="0,6,0,0" HorizontalAlignment="Center" Style="{StaticResource Text.Body}" Text="{Binding EmptyHint}" />
                </StackPanel>
            </Border>
        </StackPanel>

        <!-- Table: the compact mode -->
        <Border x:Name="Table" Style="{StaticResource Card}" Padding="0" SizeChanged="OnTableSizeChanged"
                Visibility="{Binding ModsAsTable, Converter={StaticResource Visible}}">
            <StackPanel>
                <Grid Margin="22,12">
                    <Grid.ColumnDefinitions>
                        <ColumnDefinition Width="{DynamicResource Col.Status}" />
                        <ColumnDefinition Width="*" />
                        <ColumnDefinition Width="{DynamicResource Col.Type}" />
                        <ColumnDefinition Width="{DynamicResource Col.Integrity}" />
                        <ColumnDefinition Width="{DynamicResource Col.Date}" />
                        <ColumnDefinition Width="{DynamicResource Col.Actions}" />
                    </Grid.ColumnDefinitions>
                    <Button Style="{StaticResource Button.SortHeader}" Content="{ui:Loc 'Status', Tracked=True}" Visibility="{DynamicResource Mods.WideOnly}"
                            Tag="{Binding StatusSortGlyph}" ToolTip="{ui:Loc 'Sort by status'}"
                            Command="{Binding SortByCommand}" CommandParameter="{x:Static vm:ModSortField.Status}" />
                    <Button Grid.Column="1" Style="{StaticResource Button.SortHeader}" Content="{ui:Loc 'Mod', Tracked=True}"
                            Tag="{Binding NameSortGlyph}" ToolTip="{ui:Loc 'Sort by name'}"
                            Command="{Binding SortByCommand}" CommandParameter="{x:Static vm:ModSortField.Name}" />
                    <Button Grid.Column="2" Style="{StaticResource Button.SortHeader}" Content="{ui:Loc 'Type', Tracked=True}"
                            Tag="{Binding TypeSortGlyph}" ToolTip="{ui:Loc 'Sort by type'}"
                            Command="{Binding SortByCommand}" CommandParameter="{x:Static vm:ModSortField.Type}" />
                    <Button Grid.Column="3" Style="{StaticResource Button.SortHeader}" Content="{ui:Loc 'Integrity', Tracked=True}" Visibility="{DynamicResource Mods.WideOnly}"
                            Tag="{Binding IntegritySortGlyph}" ToolTip="{ui:Loc 'Sort by integrity'}"
                            Command="{Binding SortByCommand}" CommandParameter="{x:Static vm:ModSortField.Integrity}" />
                    <Button Grid.Column="4" Style="{StaticResource Button.SortHeader}" Content="{ui:Loc 'Installed', Tracked=True}" Visibility="{DynamicResource Mods.WideOnly}"
                            Tag="{Binding InstalledSortGlyph}" ToolTip="{ui:Loc 'Sort by installation date'}"
                            Command="{Binding SortByCommand}" CommandParameter="{x:Static vm:ModSortField.Installed}" />
                </Grid>
                <Border Style="{StaticResource Divider}" />

                <ItemsControl ItemsSource="{Binding ModsView}" Focusable="False" ItemTemplate="{StaticResource ModRow}" />

                <StackPanel Margin="0,52" HorizontalAlignment="Center"
                            Visibility="{Binding ShowEmpty, Converter={StaticResource Visible}}">
                    <ContentControl Style="{StaticResource BrandMark}" Width="40" Height="40" Opacity="0.5" />
                    <TextBlock Margin="0,16,0,0" HorizontalAlignment="Center" Style="{StaticResource Text.Title}" Text="{Binding EmptyTitle}" />
                    <TextBlock Margin="0,6,0,0" HorizontalAlignment="Center" Style="{StaticResource Text.Body}" Text="{Binding EmptyHint}" />
                </StackPanel>
            </StackPanel>
        </Border>

        <!-- Files the manager did not place: a quiet line, as they can be meant to be there. -->
        <DockPanel Margin="4,14,0,0" Visibility="{Binding HasUnmanaged, Converter={StaticResource Visible}}">
            <Button DockPanel.Dock="Right" VerticalAlignment="Center" Padding="8,3" FontSize="12" Content="{ui:Loc 'Open mods folder'}"
                    ui:Icon.Glyph="&#xE838;" Command="{Binding OpenModFolderCommand}" />
            <Button DockPanel.Dock="Right" Margin="0,0,8,0" VerticalAlignment="Center" Padding="8,3" FontSize="12" Content="{ui:Loc 'Show files'}"
                    ui:Icon.Glyph="&#xE8FD;" Command="{Binding ShowUnmanagedCommand}" />
            <TextBlock DockPanel.Dock="Left" Margin="0,0,10,0" VerticalAlignment="Center" Style="{StaticResource Text.Icon}" FontSize="13"
                       Foreground="{StaticResource Brush.TextDim}" Text="&#xE8A5;" />
            <TextBlock VerticalAlignment="Center" Style="{StaticResource Text.Small}" Text="{Binding UnmanagedText}" />
        </DockPanel>
    </StackPanel>
</UserControl>
