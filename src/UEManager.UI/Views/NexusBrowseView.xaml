<UserControl x:Class="UEManager.UI.Views.NexusBrowseView"
             xmlns="http://schemas.microsoft.com/winfx/2006/xaml/presentation"
             xmlns:x="http://schemas.microsoft.com/winfx/2006/xaml"
             xmlns:d="http://schemas.microsoft.com/expression/blend/2008"
             xmlns:mc="http://schemas.openxmlformats.org/markup-compatibility/2006"
             xmlns:ui="clr-namespace:UEManager.UI"
             xmlns:vm="clr-namespace:UEManager.UI.ViewModels"
             mc:Ignorable="d"
             d:DataContext="{d:DesignInstance Type=vm:NexusBrowseViewModel}">
    <UserControl.Resources>
        <ResourceDictionary>
            <ResourceDictionary.MergedDictionaries>
                <ResourceDictionary Source="ModsResources.xaml" />
            </ResourceDictionary.MergedDictionaries>
        </ResourceDictionary>
    </UserControl.Resources>

    <StackPanel>

        <!-- Header -->
        <Grid Margin="0,6,0,0">
            <StackPanel>
                <TextBlock Style="{StaticResource Text.Overline}" Text="{ui:Loc 'Discover', Tracked=True}" />
                <TextBlock Margin="0,10,0,0" Style="{StaticResource Text.Display}" Text="{ui:Loc 'Browse mods'}" />
                <Rectangle Width="200" Height="2" Margin="0,14,0,0" HorizontalAlignment="Left" Fill="{StaticResource Brush.Stroke}" />
            </StackPanel>
            <StackPanel HorizontalAlignment="Right" VerticalAlignment="Top" Orientation="Horizontal">
                <Button Content="{ui:Loc 'Refresh'}" ui:Icon.Glyph="&#xE72C;" Command="{Binding SearchCommand}" />
                <Button Margin="8,0,0,0" Content="{ui:Loc 'Open Nexus Mods'}" ui:Icon.Glyph="&#xE8A7;" Command="{Binding OpenSiteCommand}" />
            </StackPanel>
        </Grid>

        <!-- Search -->
        <DockPanel Margin="0,26,0,0">
            <Button DockPanel.Dock="Right" Margin="10,0,0,0" Content="{Binding TranslationButtonText}" ui:Icon.Glyph="&#xE8C1;"
                    Command="{Binding ToggleOriginalCommand}" Visibility="{Binding CanTranslate, Converter={StaticResource Visible}}" />
            <Button DockPanel.Dock="Right" Margin="10,0,0,0" Style="{StaticResource Button.Primary}" Content="{ui:Loc 'Search'}" ui:Icon.Glyph="&#xE721;"
                    Command="{Binding SearchCommand}" IsDefault="{Binding IsKeyboardFocusWithin, ElementName=SearchBox}" />
            <TextBox x:Name="SearchBox" Style="{StaticResource TextBox.Search}" Text="{Binding SearchText, UpdateSourceTrigger=PropertyChanged}"
                     Tag="{ui:Loc 'Search the mod names, in any language'}" />
        </DockPanel>

        <!-- Order and count -->
        <DockPanel Margin="0,12,0,0">
            <Border DockPanel.Dock="Right" Margin="10,0,0,6" Style="{StaticResource FieldBox}">
                <TextBlock VerticalAlignment="Center" Style="{StaticResource Text.Small}" Text="{Binding CountText}" />
            </Border>
            <ItemsControl ItemsSource="{Binding SortOptions}" Focusable="False" ItemTemplate="{StaticResource FilterButton}">
                <ItemsControl.ItemsPanel>
                    <ItemsPanelTemplate>
                        <WrapPanel />
                    </ItemsPanelTemplate>
                </ItemsControl.ItemsPanel>
            </ItemsControl>
        </DockPanel>
        <TextBlock Margin="2,2,0,0" Style="{StaticResource Text.Small}" TextWrapping="Wrap" TextTrimming="None"
                   Text="{ui:Loc 'Adult content is never shown here. Texts are translated for free by Google Translate.'}" />
        <TextBlock Margin="2,4,0,0" Style="{StaticResource Text.Small}" Foreground="{StaticResource Brush.Info}" Text="{Binding SearchNote}"
                   Visibility="{Binding SearchNote, Converter={StaticResource VisibleIfSet}}" />
        <TextBlock Margin="2,4,0,0" Style="{StaticResource Text.Small}" Foreground="{StaticResource Brush.Warning}" TextWrapping="Wrap" TextTrimming="None"
                   Text="{Binding TranslationNote}" Visibility="{Binding TranslationNote, Converter={StaticResource VisibleIfSet}}" />

        <!-- Not loaded -->
        <Border Margin="0,22,0,0" Style="{StaticResource Card}" BorderBrush="{StaticResource Brush.AccentDeep}"
                Visibility="{Binding Error, Converter={StaticResource VisibleIfSet}}">
            <DockPanel>
                <Button DockPanel.Dock="Right" Margin="20,0,0,0" VerticalAlignment="Center" Content="{ui:Loc 'Try again'}"
                        ui:Icon.Glyph="&#xE72C;" Command="{Binding SearchCommand}" />
                <TextBlock DockPanel.Dock="Left" Margin="0,0,16,0" Style="{StaticResource Text.Icon}" FontSize="18"
                           Foreground="{StaticResource Brush.Accent}" Text="&#xE7BA;" />
                <StackPanel VerticalAlignment="Center">
                    <TextBlock FontWeight="SemiBold" Text="{ui:Loc 'The mod list of Nexus Mods is not available right now'}" />
                    <TextBlock Margin="0,3,0,0" Style="{StaticResource Text.Small}" TextWrapping="Wrap" TextTrimming="None" Text="{Binding Error}" />
                </StackPanel>
            </DockPanel>
        </Border>

        <!-- Nothing found -->
        <StackPanel Margin="0,52" HorizontalAlignment="Center" Visibility="{Binding ShowEmpty, Converter={StaticResource Visible}}">
            <TextBlock HorizontalAlignment="Center" Style="{StaticResource Text.Title}" Text="{ui:Loc 'No mods match the search'}" />
            <TextBlock Margin="0,6,0,0" HorizontalAlignment="Center" Style="{StaticResource Text.Body}" Text="{ui:Loc 'Try fewer or other words.'}" />
        </StackPanel>

        <!-- Mods -->
        <ItemsControl Margin="0,14,0,0" ItemsSource="{Binding Items}" Focusable="False">
            <ItemsControl.ItemTemplate>
                <DataTemplate DataType="{x:Type vm:NexusBrowseItemViewModel}">
                    <Border Margin="0,0,0,12" Style="{StaticResource Card}" Padding="0">
                        <Grid>
                            <Grid.ColumnDefinitions>
                                <ColumnDefinition Width="Auto" />
                                <ColumnDefinition Width="*" />
                                <ColumnDefinition Width="Auto" />
                            </Grid.ColumnDefinitions>

                            <!-- Cover: a click opens the preview. -->
                            <Border Width="240" MinHeight="135" Margin="1" ClipToBounds="True" Background="{StaticResource Brush.Field}"
                                    Cursor="Hand" ToolTip="{ui:Loc 'Preview'}">
                                <Border.InputBindings>
                                    <MouseBinding Gesture="LeftClick" Command="{Binding PreviewCommand}" />
                                </Border.InputBindings>
                                <Image Source="{Binding Cover}" Stretch="UniformToFill" HorizontalAlignment="Center" VerticalAlignment="Center"
                                       RenderOptions.BitmapScalingMode="HighQuality" />
                            </Border>

                            <StackPanel Grid.Column="1" Margin="20,14,16,14">
                                <Button HorizontalAlignment="Left" Style="{StaticResource Button.Name}" FontSize="16" Content="{Binding Name}"
                                        Command="{Binding PreviewCommand}" ToolTip="{ui:Loc 'Preview'}" />
                                <TextBlock Margin="0,2,0,0" Style="{StaticResource Text.Small}" Text="{Binding OriginalName}"
                                           Visibility="{Binding OriginalName, Converter={StaticResource VisibleIfSet}}" />
                                <TextBlock Margin="0,6,0,0" MaxHeight="54" FontSize="12.5" LineHeight="18" TextWrapping="Wrap" TextTrimming="CharacterEllipsis"
                                           Foreground="{StaticResource Brush.TextMuted}" Text="{Binding Summary}" ToolTip="{Binding Summary}" />
                                <StackPanel Margin="0,10,0,0" Orientation="Horizontal">
                                    <TextBlock VerticalAlignment="Center" Style="{StaticResource Text.Icon}" FontSize="11"
                                               Foreground="{StaticResource Brush.Accent}" Text="&#xEB51;" ToolTip="{ui:Loc 'Endorsements'}" />
                                    <TextBlock Margin="5,0,14,0" VerticalAlignment="Center" Style="{StaticResource Text.Small}" Text="{Binding EndorsementsText}" />
                                    <TextBlock VerticalAlignment="Center" Style="{StaticResource Text.Icon}" FontSize="11"
                                               Foreground="{StaticResource Brush.TextMuted}" Text="&#xE896;" ToolTip="{ui:Loc 'Downloads'}" />
                                    <TextBlock Margin="5,0,14,0" VerticalAlignment="Center" Style="{StaticResource Text.Small}" Text="{Binding DownloadsText}" />
                                    <TextBlock VerticalAlignment="Center" Style="{StaticResource Text.Small}" Text="{Binding MetaText}" ToolTip="{Binding MetaText}" />
                                </StackPanel>
                            </StackPanel>

                            <StackPanel Grid.Column="2" Width="170" Margin="0,14,20,14" VerticalAlignment="Center">
                                <Button Style="{StaticResource Button.Primary}" Content="{Binding ActionText}" ui:Icon.Glyph="&#xE896;"
                                        Command="{Binding InstallCommand}" Visibility="{Binding HasAction, Converter={StaticResource Visible}}" />
                                <StackPanel Margin="0,6,0,0" HorizontalAlignment="Center" Orientation="Horizontal"
                                            Visibility="{Binding StatusText, Converter={StaticResource VisibleIfSet}}">
                                    <TextBlock Margin="0,0,6,0" Style="{StaticResource Text.Icon}" FontSize="12" Foreground="{StaticResource Brush.Success}" Text="&#xE73E;" />
                                    <TextBlock VerticalAlignment="Center" FontSize="12" Foreground="{StaticResource Brush.Success}" Text="{Binding StatusText}" />
                                </StackPanel>
                                <StackPanel Margin="0,10,0,0" HorizontalAlignment="Center" Orientation="Horizontal">
                                    <Button Padding="8,3" FontSize="12" Content="{ui:Loc 'Preview'}" ui:Icon.Glyph="&#xE7B3;" Command="{Binding PreviewCommand}" />
                                    <Button Margin="6,0,0,0" Padding="8,3" FontSize="12" Content="{ui:Loc 'Page'}" ui:Icon.Glyph="&#xE774;"
                                            Command="{Binding OpenPageCommand}" ToolTip="{ui:Loc 'The mod\'s page on Nexus Mods'}" />
                                </StackPanel>
                                <TextBlock Margin="0,8,0,0" HorizontalAlignment="Center" Style="{StaticResource Text.Small}"
                                           Text="{Binding AuthorText}" ToolTip="{Binding AuthorText}" />
                            </StackPanel>
                        </Grid>
                    </Border>
                </DataTemplate>
            </ItemsControl.ItemTemplate>
        </ItemsControl>

        <TextBlock Margin="0,28" HorizontalAlignment="Center" Style="{StaticResource Text.Body}" Text="{ui:Loc 'Loading mods from Nexus Mods…'}"
                   Visibility="{Binding IsLoading, Converter={StaticResource Visible}}" />
        <Button Margin="0,6,0,0" HorizontalAlignment="Center" Content="{ui:Loc 'Load more'}" ui:Icon.Glyph="&#xE70D;"
                Command="{Binding LoadMoreCommand}" Visibility="{Binding HasMore, Converter={StaticResource Visible}}" />
    </StackPanel>
</UserControl>
