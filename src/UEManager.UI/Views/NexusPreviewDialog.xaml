<UserControl x:Class="UEManager.UI.Views.NexusPreviewDialog"
             xmlns="http://schemas.microsoft.com/winfx/2006/xaml/presentation"
             xmlns:x="http://schemas.microsoft.com/winfx/2006/xaml"
             xmlns:d="http://schemas.microsoft.com/expression/blend/2008"
             xmlns:mc="http://schemas.openxmlformats.org/markup-compatibility/2006"
             xmlns:ui="clr-namespace:UEManager.UI"
             xmlns:vm="clr-namespace:UEManager.UI.ViewModels"
             mc:Ignorable="d"
             d:DataContext="{d:DesignInstance Type=vm:NexusPreviewViewModel}">
    <UserControl.Resources>
        <DataTemplate x:Key="PreviewLine" DataType="{x:Type vm:NexusPreviewBlock}">
            <Grid x:Name="Line" Margin="0,0,0,6">
                <Grid.ColumnDefinitions>
                    <ColumnDefinition Width="Auto" />
                    <ColumnDefinition Width="*" />
                </Grid.ColumnDefinitions>
                <TextBlock x:Name="Bullet" Margin="6,0,10,0" Foreground="{StaticResource Brush.Accent}" Text="•" Visibility="Collapsed" />
                <TextBlock x:Name="Words" Grid.Column="1" FontSize="13" LineHeight="20" TextWrapping="Wrap"
                           Foreground="{StaticResource Brush.TextMuted}" Text="{Binding Text}" />
            </Grid>
            <DataTemplate.Triggers>
                <DataTrigger Binding="{Binding IsHeading}" Value="True">
                    <Setter TargetName="Line" Property="Margin" Value="0,10,0,6" />
                    <Setter TargetName="Words" Property="FontSize" Value="15" />
                    <Setter TargetName="Words" Property="FontWeight" Value="SemiBold" />
                    <Setter TargetName="Words" Property="Foreground" Value="{StaticResource Brush.Text}" />
                </DataTrigger>
                <DataTrigger Binding="{Binding IsItem}" Value="True">
                    <Setter TargetName="Bullet" Property="Visibility" Value="Visible" />
                </DataTrigger>
            </DataTemplate.Triggers>
        </DataTemplate>
    </UserControl.Resources>

    <!-- As tall as the window allows, so a long description scrolls inside it. -->
    <Border Style="{StaticResource Dialog}" Width="900" MaxHeight="1000" Padding="0" VerticalAlignment="Stretch">
        <DockPanel>
            <DockPanel DockPanel.Dock="Top" Margin="28,22,18,14">
                <Button DockPanel.Dock="Right" VerticalAlignment="Top" Style="{StaticResource Button.Icon}" ui:Icon.Glyph="&#xE711;"
                        Command="{Binding CloseCommand}" ToolTip="{ui:Loc 'Close'}" />
                <StackPanel>
                    <TextBlock Style="{StaticResource Text.Overline}" Text="{ui:Loc 'Mod preview', Tracked=True}" />
                    <TextBlock Margin="0,8,0,0" Style="{StaticResource Text.Title}" TextWrapping="Wrap" Text="{Binding Item.Name}" />
                    <TextBlock Margin="0,2,0,0" Style="{StaticResource Text.Small}" Text="{Binding Item.OriginalName}"
                               Visibility="{Binding Item.OriginalName, Converter={StaticResource VisibleIfSet}}" />
                    <StackPanel Margin="0,8,0,0" Orientation="Horizontal">
                        <TextBlock VerticalAlignment="Center" Style="{StaticResource Text.Icon}" FontSize="11"
                                   Foreground="{StaticResource Brush.Accent}" Text="&#xEB51;" ToolTip="{ui:Loc 'Endorsements'}" />
                        <TextBlock Margin="5,0,14,0" VerticalAlignment="Center" Style="{StaticResource Text.Small}" Text="{Binding Item.EndorsementsText}" />
                        <TextBlock VerticalAlignment="Center" Style="{StaticResource Text.Icon}" FontSize="11"
                                   Foreground="{StaticResource Brush.TextMuted}" Text="&#xE896;" ToolTip="{ui:Loc 'Downloads'}" />
                        <TextBlock Margin="5,0,14,0" VerticalAlignment="Center" Style="{StaticResource Text.Small}" Text="{Binding Item.DownloadsText}" />
                        <TextBlock VerticalAlignment="Center" Style="{StaticResource Text.Small}" Text="{Binding Item.AuthorText}" />
                        <TextBlock Margin="14,0,0,0" VerticalAlignment="Center" Style="{StaticResource Text.Small}" Text="{Binding Item.MetaText}" />
                    </StackPanel>
                </StackPanel>
            </DockPanel>

            <Border DockPanel.Dock="Bottom" Padding="28,14" BorderBrush="{StaticResource Brush.Line}" BorderThickness="0,1,0,0">
                <DockPanel>
                    <StackPanel DockPanel.Dock="Right" Orientation="Horizontal">
                        <Button Content="{ui:Loc 'Close'}" Command="{Binding CloseCommand}" />
                        <Button Margin="8,0,0,0" Style="{StaticResource Button.Primary}" Content="{Binding Item.ActionText}" ui:Icon.Glyph="&#xE896;"
                                Command="{Binding InstallCommand}" Visibility="{Binding Item.HasAction, Converter={StaticResource Visible}}" />
                    </StackPanel>
                    <StackPanel Orientation="Horizontal">
                        <Button Content="{Binding Page.TranslationButtonText}" ui:Icon.Glyph="&#xE8C1;" Command="{Binding Page.ToggleOriginalCommand}"
                                Visibility="{Binding Page.CanTranslate, Converter={StaticResource Visible}}" />
                        <Button Margin="8,0,0,0" Content="{ui:Loc 'Open on Nexus Mods'}" ui:Icon.Glyph="&#xE8A7;" Command="{Binding Item.OpenPageCommand}" />
                    </StackPanel>
                </DockPanel>
            </Border>

            <ScrollViewer x:Name="Scroller" Padding="28,0,28,18" VerticalScrollBarVisibility="Auto" HorizontalScrollBarVisibility="Disabled">
                <StackPanel>
                    <Image MaxHeight="440" HorizontalAlignment="Left" Source="{Binding Picture}" Stretch="Uniform" RenderOptions.BitmapScalingMode="HighQuality" />
                    <TextBlock Margin="0,14,0,0" Style="{StaticResource Text.Body}" TextWrapping="Wrap" Text="{Binding Item.Summary}" />
                    <Border Margin="0,16,0,14" Style="{StaticResource Divider}" />

                    <StackPanel Visibility="{Binding HasChanges, Converter={StaticResource Visible}}">
                        <TextBlock Style="{StaticResource Text.Overline}" Text="{ui:Loc 'Changelog', Tracked=True}" />
                        <ItemsControl ItemsSource="{Binding Changes}" ItemTemplate="{StaticResource PreviewLine}" Focusable="False" />
                        <Border Margin="0,8,0,14" Style="{StaticResource Divider}" />
                    </StackPanel>

                    <TextBlock Style="{StaticResource Text.Small}" Text="{ui:Loc 'Loading the description…'}"
                               Visibility="{Binding IsLoading, Converter={StaticResource Visible}}" />
                    <TextBlock Style="{StaticResource Text.Small}" Foreground="{StaticResource Brush.Accent}" TextWrapping="Wrap" TextTrimming="None"
                               Text="{Binding Error}" Visibility="{Binding Error, Converter={StaticResource VisibleIfSet}}" />
                    <TextBlock Margin="0,0,0,10" Style="{StaticResource Text.Small}" Foreground="{StaticResource Brush.Info}" TextWrapping="Wrap" TextTrimming="None"
                               Text="{Binding Note}" Visibility="{Binding Note, Converter={StaticResource VisibleIfSet}}" />

                    <ItemsControl ItemsSource="{Binding Blocks}" ItemTemplate="{StaticResource PreviewLine}" Focusable="False" />

                    <ItemsControl Margin="0,10,0,0" ItemsSource="{Binding Pictures}" Focusable="False">
                        <ItemsControl.ItemTemplate>
                            <DataTemplate>
                                <Image Margin="0,0,0,10" MaxHeight="420" HorizontalAlignment="Left" Source="{Binding}" Stretch="Uniform"
                                       RenderOptions.BitmapScalingMode="HighQuality" />
                            </DataTemplate>
                        </ItemsControl.ItemTemplate>
                    </ItemsControl>
                </StackPanel>
            </ScrollViewer>
        </DockPanel>
    </Border>
</UserControl>
