<UserControl x:Class="UEManager.UI.Views.Ue4ssView"
             xmlns="http://schemas.microsoft.com/winfx/2006/xaml/presentation"
             xmlns:x="http://schemas.microsoft.com/winfx/2006/xaml"
             xmlns:d="http://schemas.microsoft.com/expression/blend/2008"
             xmlns:mc="http://schemas.openxmlformats.org/markup-compatibility/2006"
             xmlns:ui="clr-namespace:UEManager.UI"
             xmlns:vm="clr-namespace:UEManager.UI.ViewModels"
             mc:Ignorable="d"
             d:DataContext="{d:DesignInstance Type=vm:MainViewModel}">
    <UserControl.Resources>
        <Style x:Key="FieldLabel" TargetType="TextBlock" BasedOn="{StaticResource Text.Caption}">
            <Setter Property="Width" Value="150" />
            <Setter Property="VerticalAlignment" Value="Center" />
        </Style>
        <Style x:Key="Field" TargetType="DockPanel">
            <Setter Property="Margin" Value="0,0,0,10" />
        </Style>
        <!-- The errors and warnings in a tab of the log, next to its name. -->
        <DataTemplate x:Key="TabCount" DataType="{x:Type vm:Ue4ssLogTabCount}">
            <Border Margin="8,0,0,0" Padding="6,0" MinWidth="18" CornerRadius="8" VerticalAlignment="Center"
                    Background="{Binding Tone, Converter={StaticResource Tone}, ConverterParameter=wash}"
                    Visibility="{Binding Shows, Converter={StaticResource Visible}}">
                <TextBlock HorizontalAlignment="Center" FontSize="11.5" Foreground="{Binding Tone, Converter={StaticResource Tone}}" Text="{Binding Text}" />
            </Border>
        </DataTemplate>
    </UserControl.Resources>

    <StackPanel>
        <StackPanel Margin="0,6,0,0">
            <TextBlock Style="{StaticResource Text.Overline}" Text="{ui:Loc 'Script loader', Tracked=True}" />
            <TextBlock Margin="0,10,0,0" Style="{StaticResource Text.Display}" Text="UE4SS" />
            <Rectangle Width="200" Height="2" Margin="0,14,0,0" HorizontalAlignment="Left" Fill="{StaticResource Brush.Stroke}" />
        </StackPanel>

        <!-- Runtime -->
        <Border Margin="0,28,0,0" Style="{StaticResource Card}">
            <StackPanel>
                <TextBlock Style="{StaticResource Text.Title}" Text="{ui:Loc 'Runtime'}" />
                <TextBlock Margin="0,6,0,18" Style="{StaticResource Text.Body}"
                           Text="{ui:Loc 'Install and update keep your UE4SS settings, mods.txt and the files of your mods. Close the game before you change UE4SS.'}" />
                <DockPanel Style="{StaticResource Field}">
                    <TextBlock Style="{StaticResource FieldLabel}" Text="{ui:Loc 'Status', Tracked=True}" />
                    <TextBlock Style="{StaticResource Text.Small}" Foreground="{StaticResource Brush.Text}" Text="{Binding Ue4ssText}" />
                </DockPanel>
                <DockPanel Style="{StaticResource Field}">
                    <TextBlock Style="{StaticResource FieldLabel}" Text="{ui:Loc 'UE4SS folder', Tracked=True}" />
                    <TextBlock Style="{StaticResource Text.Path}" Text="{Binding Ue4ssFolderPath}" />
                </DockPanel>
                <DockPanel Style="{StaticResource Field}">
                    <TextBlock Style="{StaticResource FieldLabel}" Text="{ui:Loc 'Mods folder', Tracked=True}" />
                    <TextBlock Style="{StaticResource Text.Path}" Text="{Binding Ue4ssModsPath}" />
                </DockPanel>
                <DockPanel Style="{StaticResource Field}">
                    <TextBlock Style="{StaticResource FieldLabel}" Text="{ui:Loc 'Your mods', Tracked=True}" />
                    <TextBlock Style="{StaticResource Text.Small}" Foreground="{StaticResource Brush.Text}" Text="{Binding Ue4ssModsText}" />
                </DockPanel>
                <WrapPanel Margin="0,10,0,0">
                    <Button Margin="0,0,8,8" Style="{StaticResource Button.Primary}" Content="{ui:Loc 'Install UE4SS…'}" ui:Icon.Glyph="&#xE896;"
                            Command="{Binding ShowUe4ssGuideCommand}"
                            Visibility="{Binding IsUe4ssMissing, Converter={StaticResource Visible}}" />
                    <Button Margin="0,0,8,8" Style="{StaticResource Button.Primary}" Content="{Binding Ue4ssUpdateText}"
                            ui:Icon.Glyph="&#xE896;" Command="{Binding UpdateUe4ssCommand}"
                            Visibility="{Binding IsUe4ssUpdateAvailable, Converter={StaticResource Visible}}" />
                    <Button Margin="0,0,8,8" Content="{ui:Loc 'Open UE4SS folder'}" ui:Icon.Glyph="&#xE838;" Command="{Binding OpenUe4ssFolderCommand}"
                            Visibility="{Binding IsUe4ssInstalled, Converter={StaticResource Visible}}" />
                    <Button Margin="0,0,8,8" Content="{ui:Loc 'Remove UE4SS…'}" ui:Icon.Glyph="&#xE74D;" Command="{Binding RemoveUe4ssCommand}"
                            Visibility="{Binding IsUe4ssInstalled, Converter={StaticResource Visible}}" />
                </WrapPanel>
            </StackPanel>
        </Border>

        <!-- Log -->
        <Border Margin="0,20,0,0" Style="{StaticResource Card}" DataContext="{Binding Ue4ssLogPanel}">
            <StackPanel>
                <DockPanel>
                    <StackPanel DockPanel.Dock="Right" Orientation="Horizontal" VerticalAlignment="Top">
                        <Button Content="{ui:Loc 'Refresh'}" ui:Icon.Glyph="&#xE72C;" Command="{Binding RefreshCommand}" ToolTip="F5" />
                        <!-- Clear deletes the log file; UE4SS writes a new one at the next game start. -->
                        <Button Margin="8,0,0,0" Content="{ui:Loc 'Clear'}" ui:Icon.Glyph="&#xE894;" Command="{Binding ClearCommand}"
                                IsEnabled="{Binding HasLog}" ToolTip="{ui:Loc 'Delete the log, so the old lines are gone. UE4SS writes a new one at the next game start.'}" />
                        <Button Margin="8,0,0,0" Content="{ui:Loc 'Copy'}" ui:Icon.Glyph="&#xE8C8;" Command="{Binding CopyCommand}"
                                IsEnabled="{Binding HasLog}" ToolTip="{ui:Loc 'Copy the log, to paste it where you ask for help'}" />
                        <Button Margin="8,0,0,0" Content="{ui:Loc 'Open log file'}" ui:Icon.Glyph="&#xE8A5;" Command="{Binding OpenLogCommand}"
                                IsEnabled="{Binding HasLog}" />
                        <Button Margin="8,0,0,0" Content="{ui:Loc 'Report a problem…'}" ui:Icon.Glyph="&#xE897;"
                                Command="{Binding DataContext.ShowHelpDialogCommand, RelativeSource={RelativeSource AncestorType=UserControl}}" />
                    </StackPanel>
                    <TextBlock Style="{StaticResource Text.Title}" Text="{ui:Loc 'Log'}" />
                </DockPanel>
                <StackPanel Margin="0,16,0,0" Orientation="Horizontal">
                    <Ellipse Width="7" Height="7" VerticalAlignment="Center" Fill="{Binding SummaryTone, Converter={StaticResource Tone}}" />
                    <TextBlock Margin="9,0,0,0" VerticalAlignment="Center" Style="{StaticResource Text.Small}"
                               Foreground="{StaticResource Brush.Text}" Text="{Binding SummaryText}" />
                </StackPanel>
                <TextBlock Margin="16,6,0,0" Style="{StaticResource Text.Small}" Foreground="{StaticResource Brush.Danger}"
                           TextWrapping="Wrap" Text="{Binding ErrorModsText}"
                           Visibility="{Binding HasErrorMods, Converter={StaticResource Visible}}" />
                <!-- Who wrote the lines: UE4SS, the player's mods, or a Lua script that does not say which mod it is. -->
                <Border Margin="0,14,0,0" BorderBrush="{StaticResource Brush.Line}" BorderThickness="0,0,0,1"
                        Visibility="{Binding HasLog, Converter={StaticResource Visible}}">
                    <StackPanel Orientation="Horizontal">
                        <RadioButton Style="{StaticResource Tab}" GroupName="Ue4ssLogTab" IsChecked="{Binding IsUe4ssTab}"
                                     ToolTip="{ui:Loc 'Lines of UE4SS itself and of the mods it comes with'}">
                            <StackPanel Orientation="Horizontal">
                                <TextBlock Text="UE4SS" />
                                <ContentControl Content="{Binding Ue4ssCount}" ContentTemplate="{StaticResource TabCount}" Focusable="False" />
                            </StackPanel>
                        </RadioButton>
                        <RadioButton Style="{StaticResource Tab}" GroupName="Ue4ssLogTab" IsChecked="{Binding IsModsTab}"
                                     ToolTip="{ui:Loc 'Lines of your mods'}">
                            <StackPanel Orientation="Horizontal">
                                <TextBlock Text="{ui:Loc 'Mods'}" />
                                <ContentControl Content="{Binding ModsCount}" ContentTemplate="{StaticResource TabCount}" Focusable="False" />
                            </StackPanel>
                        </RadioButton>
                        <RadioButton Style="{StaticResource Tab}" GroupName="Ue4ssLogTab" IsChecked="{Binding IsUnnamedTab}"
                                     ToolTip="{ui:Loc 'Lines of a Lua script that does not say which mod it is'}">
                            <StackPanel Orientation="Horizontal">
                                <TextBlock Text="{ui:Loc 'Unnamed'}" />
                                <ContentControl Content="{Binding UnnamedCount}" ContentTemplate="{StaticResource TabCount}" Focusable="False" />
                            </StackPanel>
                        </RadioButton>
                    </StackPanel>
                </Border>
                <DockPanel Margin="0,12,0,10" Visibility="{Binding HasLog, Converter={StaticResource Visible}}">
                    <CheckBox DockPanel.Dock="Left" VerticalAlignment="Center" Content="{ui:Loc 'Only errors and warnings'}" IsChecked="{Binding OnlyProblems}" />
                    <TextBox x:Name="SearchBox" DockPanel.Dock="Right" Width="320" Style="{StaticResource TextBox.Search}" Text="{Binding SearchText, UpdateSourceTrigger=PropertyChanged}"
                             ToolTip="Ctrl+F" Tag="{ui:Loc 'Search the log, such as a mod name'}" />
                    <TextBlock Margin="16,0,12,0" VerticalAlignment="Center" HorizontalAlignment="Right" Style="{StaticResource Text.Small}"
                               Text="{Binding FoundText}" Visibility="{Binding IsSearching, Converter={StaticResource Visible}}" />
                </DockPanel>
                <Grid Visibility="{Binding HasLog, Converter={StaticResource Visible}}">
                    <ItemsControl x:Name="LogLines" Height="380" ItemsSource="{Binding ShownLines}" Focusable="False"
                                  VirtualizingPanel.IsVirtualizing="True" VirtualizingPanel.ScrollUnit="Pixel">
                        <ItemsControl.Template>
                            <ControlTemplate TargetType="ItemsControl">
                                <Border Background="{StaticResource Brush.Field}" BorderBrush="{StaticResource Brush.Line}"
                                        BorderThickness="1" CornerRadius="2">
                                    <ScrollViewer x:Name="LogScroll" Padding="12,8" CanContentScroll="True" Focusable="False"
                                                  HorizontalScrollBarVisibility="Auto" VerticalScrollBarVisibility="Auto">
                                        <ItemsPresenter />
                                    </ScrollViewer>
                                </Border>
                            </ControlTemplate>
                        </ItemsControl.Template>
                        <ItemsControl.ItemsPanel>
                            <ItemsPanelTemplate>
                                <VirtualizingStackPanel />
                            </ItemsPanelTemplate>
                        </ItemsControl.ItemsPanel>
                        <ItemsControl.ItemTemplate>
                            <DataTemplate DataType="{x:Type vm:Ue4ssLogLineItem}">
                                <StackPanel Orientation="Horizontal">
                                    <TextBlock FontFamily="Cascadia Mono, Consolas" FontSize="12" LineHeight="18"
                                               Foreground="{Binding Tone, Converter={StaticResource Tone}}" Text="{Binding Text}" />
                                    <Border Margin="12,0,0,0" Padding="6,0" VerticalAlignment="Center" CornerRadius="2"
                                            Background="{StaticResource Brush.TextMutedWash}"
                                            Visibility="{Binding Known, Converter={StaticResource Visible}}"
                                            ToolTip="{ui:Loc 'UE4SS writes this line at every start with this game. It does no harm, so it does not count as an error.'}">
                                        <TextBlock FontFamily="{DynamicResource Font.Label}" FontSize="11" Foreground="{StaticResource Brush.TextMuted}"
                                                   Text="{ui:Loc 'known, harmless'}" />
                                    </Border>
                                </StackPanel>
                            </DataTemplate>
                        </ItemsControl.ItemTemplate>
                    </ItemsControl>
                    <TextBlock HorizontalAlignment="Center" VerticalAlignment="Center" Style="{StaticResource Text.Small}"
                               Text="{ui:Loc 'No lines to show.'}" Visibility="{Binding IsTabEmpty, Converter={StaticResource Visible}}" />
                </Grid>
            </StackPanel>
        </Border>
    </StackPanel>
</UserControl>
